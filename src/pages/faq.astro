---
import Layout from '../layouts/Layout.astro';
import FaqList from '../components/sections/FaqList.astro';
---

<Layout title="FAQ" description="Frequently asked questions about Montgomery Computer Science Club.">
  <section class="bg-warm-white text-near-black px-6 py-16">
    <div class="mx-auto flex max-w-3xl flex-col gap-8">
      <div class="flex flex-col gap-2">
        <h1 class="font-heading text-4xl font-bold">FAQ</h1>
        <p class="font-body text-near-black/70">
          Answers to common questions. Still curious about something? Reach out — our email is in
          the footer.
        </p>
      </div>

      <FaqList />
    </div>
  </section>
</Layout>
