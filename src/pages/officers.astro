---
import Layout from '../layouts/Layout.astro';
import OfficersGrid from '../components/sections/OfficersGrid.astro';
import { getCollection } from 'astro:content';
import CliHeading from '../components/ui/CliHeading.astro';

const officers = await getCollection('officers');
---

<Layout title="Officers" description="Meet the officers of Montgomery Computer Science Club.">
  <section class="bg-near-black text-warm-white px-6 py-16">
    <div class="mx-auto flex max-w-4xl flex-col gap-8">
      <div class="flex flex-col gap-2">
        <CliHeading as="h1" text="Officers" class="font-heading text-4xl font-bold" />
        <p class="font-body text-warm-white/80 max-w-2xl">Meet the team running the club.</p>
      </div>

      <OfficersGrid officers={officers} />
    </div>
  </section>
</Layout>
