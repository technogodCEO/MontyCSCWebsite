---
import Layout from '../layouts/Layout.astro';
import SignUpForm from '../components/sections/SignUpForm.vue';
---

<Layout title="Sign Up" description="Sign up for Montgomery Computer Science Club.">
  <section class="bg-warm-white text-near-black px-6 py-16">
    <div class="mx-auto flex max-w-3xl flex-col gap-8">
      <div class="flex flex-col gap-2 text-center">
        <h1 class="font-heading text-4xl font-bold">Sign Up</h1>
        <p class="font-body text-near-black/70">
          Join Montgomery Computer Science Club — it only takes a minute.
        </p>
      </div>

      <SignUpForm client:load />
    </div>
  </section>
</Layout>
