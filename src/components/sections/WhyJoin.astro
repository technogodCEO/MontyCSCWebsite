---
// src/components/sections/WhyJoin.astro
// Static homepage section pitching membership. No collection data needed.
import CliHeading from '../ui/CliHeading.astro';

const reasons = [
  {
    title: 'No experience required',
    body: "Every workshop starts from the basics and builds up, so it doesn't matter if you've never coded or you already know five languages.",
  },
  {
    title: 'Trained instructors',
    body: "Sessions are led by peers and mentors who can actually teach. Coding well and teaching well aren't the same thing.",
  },
  {
    title: 'A real community',
    body: "Hackathons, guest talks, and competitions mean you're building with people, not just working through a syllabus alone.",
  },
];
---

<section class="bg-deep-green text-warm-white px-6 py-16">
  <div class="mx-auto flex max-w-5xl flex-col gap-8">
    <CliHeading as="h2" text="Why Join" class="font-heading text-3xl font-bold" />

    <ul class="grid gap-6 md:grid-cols-3">
      {
        reasons.map((reason) => (
          <li class="flex flex-col gap-2">
            <CliHeading
              as="h3"
              text={reason.title}
              animate={false}
              class="font-heading text-gold text-xl font-semibold"
            />
            <p class="font-body text-warm-white/80 text-sm">{reason.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
