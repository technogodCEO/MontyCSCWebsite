---
// src/components/sections/EventList.astro
// Full events list for the Events page (assumes entries are pre-sorted by
// the page's getCollection() fetch).
import type { CollectionEntry } from 'astro:content';
import CliHeading from '../ui/CliHeading.astro';

interface Props {
  events: CollectionEntry<'events'>[];
}
const { events } = Astro.props;
---

<ul class="flex flex-col gap-4">
  {
    events.map((event) => (
      <li class="border-accent-green/40 flex flex-col gap-2 rounded-lg border p-5">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <CliHeading as="h2" text={event.data.title} animate={false} class="font-heading text-xl font-semibold" />
          <span class="text-gold font-mono text-xs uppercase tracking-wide">
            {event.data.type}
          </span>
        </div>
        <p class="font-body text-warm-white/70 text-sm">
          {new Date(event.data.date).toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </p>
        {event.data.description && (
          <p class="font-body text-warm-white/80 text-sm">{event.data.description}</p>
        )}
        {event.data.link && (
          <a
            href={event.data.link}
            class="text-gold hover:text-warm-white w-fit font-body text-sm underline underline-offset-2 transition-colors"
          >
            Learn more
          </a>
        )}
      </li>
    ))
  }
</ul>
