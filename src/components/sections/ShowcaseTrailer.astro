---
// src/components/sections/ShowcaseTrailer.astro
// Showcase page trailer block. Receives the build-time existence check as a
// prop (fs access stays in the page per the "pages fetch data" convention)
// so a missing asset renders a clear placeholder instead of a broken <video>.
import CliHeading from '../ui/CliHeading.astro';

interface Props {
  hasTrailer: boolean;
}
const { hasTrailer } = Astro.props;
---

<div class="flex flex-col gap-4">
  <CliHeading as="h2" text="Trailer" class="font-heading text-2xl font-semibold" />
  {
    hasTrailer ? (
      <video controls class="w-full rounded-lg" src="/showcase/trailer.mp4">
        Your browser does not support the video tag.
      </video>
    ) : (
      <div class="border-accent-green/40 text-warm-white/60 flex aspect-video w-full items-center justify-center rounded-lg border font-mono text-sm">
        Trailer coming soon
      </div>
    )
  }
</div>
