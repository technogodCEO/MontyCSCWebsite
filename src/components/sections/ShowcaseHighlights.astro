---
// src/components/sections/ShowcaseHighlights.astro
// Homepage teaser pulling a few showcase entries. Falls back to a
// brand-styled placeholder card when an entry has no image, matching the
// Officers avatar-fallback pattern described in the design spec.
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'showcase'>[];
}
const { entries } = Astro.props;

const preview = entries.slice(0, 3);
---

<section class="bg-near-black text-warm-white px-6 py-16">
  <div class="mx-auto flex max-w-5xl flex-col gap-8">
    <div class="flex flex-col gap-2">
      <h2 class="font-heading text-3xl font-bold">From the Showcase</h2>
      <p class="font-body text-warm-white/80 max-w-2xl">
        A few projects our members have built at MontyHacks and beyond.
      </p>
    </div>

    <ul class="grid gap-6 md:grid-cols-3">
      {
        preview.map((entry) => (
          <li class="border-accent-green/40 flex flex-col gap-3 overflow-hidden rounded-lg border">
            {entry.data.image ? (
              <img src={entry.data.image} alt={entry.data.title} class="h-40 w-full object-cover" />
            ) : (
              <div class="bg-deep-green text-accent-green flex h-40 w-full items-center justify-center font-mono text-sm">
                {entry.data.title}
              </div>
            )}
            <div class="flex flex-col gap-1 p-4">
              <h3 class="font-heading text-lg font-semibold">{entry.data.title}</h3>
              <p class="font-body text-warm-white/70 text-sm">{entry.data.event}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <a
      href="/showcase"
      class="border-gold text-gold hover:bg-gold hover:text-near-black w-fit rounded-full border px-5 py-2 font-body text-sm transition-colors"
    >
      Visit the full showcase
    </a>
  </div>
</section>
